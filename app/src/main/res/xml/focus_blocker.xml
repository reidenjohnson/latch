<?xml version="1.0" encoding="utf-8"?>
<!-- Focus only needs to know which app opened. It can't read screen content (canRetrieveWindowContent=false).
     https://developer.android.com/reference/android/accessibilityservice/AccessibilityServiceInfo -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/focus_blocker_description"
    android:notificationTimeout="100"
    android:summary="@string/focus_blocker_summary" />
